rules_version = '2';

// =====================================================================
//  REGRAS DE SEGURANÇA — RPG NARUTO NEW AGE
//
//  Ideia geral:
//  - Kage/Conselheiro (admins) podem alterar qualquer coisa pelo site.
//  - Pelo CONSOLE do Firebase você sempre pode editar tudo (o console
//    ignora estas regras).
//  - Jogadores só conseguem mudar saldo (Ryos, EN, XP) por operações
//    "honestas", que estas regras conferem com os dados do banco:
//      compra no preço cadastrado, presente (sai de um, entra no outro),
//      recompensa de missão/conquista APROVADA pelo Kage, troca EN→Ryos
//      na taxa oficial, pagamento de mentoria no preço do mentor.
//  - Qualquer outra tentativa (ex.: "me dar 1 milhão de Ryos" pelo
//    console do navegador) é recusada.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Funções gerais ----------------
    function logado() { return request.auth != null; }
    function isAdmin() {
      return logado() && request.auth.token.email in ['admin@rpgnaruto.com', 'conselheiro@rpgnaruto.com'];
    }
    function caminho(colecao, id) { return /databases/$(database)/documents/$(colecao)/$(id); }
    // Números cadastrados às vezes estão como texto ("1000"): converte com segurança
    function numero(v) { return v is number ? v : (v is string && v.matches('^-?[0-9]+([.][0-9]+)?$') ? float(v) : 0); }

    // Preço/moeda de um item do catálogo (iguais aos da ficha, mas usados também pelo cofre)
    function moedaItem(item) { return numero(item.get('preco_en', 0)) > 0 ? 'essencia_ninja' : 'ryos'; }
    function precoItem(item) {
      return moedaItem(item) == 'essencia_ninja'
        ? numero(item.preco_en)
        : ((item.get('preco_promocional', null) != null && numero(item.preco_promocional) > 0 && numero(item.preco_promocional) < numero(item.get('preco', 0)))
            ? numero(item.preco_promocional)
            : numero(item.get('preco', 0)));
    }

    // ---------------- COFRE DA VILA ----------------
    // vila/banco = { saldo, ultimoMov }. Cada entrada de dinheiro vem com um comprovante
    // em vila_movimentos, e as regras conferem de onde ele veio e o valor exato:
    //   imposto_loja (10% da compra em Ryos), missao (20% da recompensa),
    //   arena (5% do cofre Competitivo em Ryos) e doacao (sai da ficha de quem doa).
    // Saídas (salários) e ajustes: só o Kage.
    match /vila/{vid} {
      allow read: if logado();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (logado() && vid == 'banco' && entradaValida(request.resource.data.get('ultimoMov', '')));
      function entradaValida(mid) {
        return mid != '' && !exists(caminho('vila_movimentos', mid)) && existsAfter(caminho('vila_movimentos', mid))
          && entradaNoCampo(getAfter(caminho('vila_movimentos', mid)).data, getAfter(caminho('vila_movimentos', mid)).data.get('moeda', 'ryos') == 'essencia_ninja' ? 'saldo_en' : 'saldo');
      }
      function entradaNoCampo(mv, campo) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([campo, 'ultimoMov'])
          && request.resource.data.get(campo, 0) == resource.data.get(campo, 0) + mv.valor;
      }
    }
    match /vila_movimentos/{mid} {
      function m() { return request.resource.data; }
      function eu() { return caminho('users', request.auth.uid); }
      function bancoSobe() {
        let campo = m().get('moeda', 'ryos') == 'essencia_ninja' ? 'saldo_en' : 'saldo';
        return getAfter(caminho('vila', 'banco')).data.get('ultimoMov', '') == mid
          && getAfter(caminho('vila', 'banco')).data.get(campo, 0) == get(caminho('vila', 'banco')).data.get(campo, 0) + m().valor;
      }
      // Aposta: 5% de cada aposta vai para o cofre na hora (na moeda da aposta)
      function apostaOk() {
        let ap = getAfter(/databases/$(database)/documents/desafios_batalha/$(m().ref)/apostas/$(request.auth.uid)).data;
        return mid == 'aposta_' + m().ref + '_' + request.auth.uid
          && m().get('moeda', 'ryos') == ap.moeda && m().valor == ap.valor - ap.liquido;
      }
      // Doação: o mesmo valor sai da ficha de quem doa
      function doacaoOk() {
        return getAfter(eu()).data.get('ultimaDoacao', '') == mid
          && numero(get(eu()).data.get('ryos', 0)) - numero(getAfter(eu()).data.get('ryos', 0)) == m().valor;
      }
      // Imposto da loja: 10% (para baixo) de uma compra em Ryos feita NESTE envio
      function impostoOk() {
        let c = getAfter(eu()).data.get('ultimaCompra', {});
        return c.get('mov', '') == mid && get(eu()).data.get('ultimaCompra', {}).get('mov', '') != mid
          && impostoValor(c, get(caminho(c.tipo == 'jutsu' ? 'jutsus' : c.tipo, c.id)).data);
      }
      function impostoValor(c, item) {
        let qtd = c.tipo == 'jutsu' ? 1 : getAfter(eu()).data.inventario.get(c.id, 0) - get(eu()).data.get('inventario', {}).get(c.id, 0);
        return moedaItem(item) == 'ryos' && m().valor == math.floor(precoItem(item) * qtd / 10.0);
      }
      // Missão: 20% da recompensa, uma vez por missão (o id do comprovante é fixo)
      function missaoOk() {
        let c = getAfter(eu()).data.get('ultimaColeta', {});
        return c.get('tipo', '') == 'missao' && mid == 'missao_' + request.auth.uid + '_' + c.id
          && get(eu()).data.get('statusMissoes', {}).get(c.id, '') == 'aprovado'
          && getAfter(eu()).data.statusMissoes.get(c.id, '') == 'concluido'
          && m().valor == math.floor(numero(get(caminho('missoes', c.id)).data.get('recompensa', 0)) / 5.0);
      }
      // Arena: 5% do cofre Competitivo em Ryos, quando o vencedor recebe (uma vez por luta)
      function arenaOk() {
        let b = get(caminho('desafios_batalha', m().ref)).data;
        return mid == 'arena_' + m().ref && b.aposta.moeda == 'ryos'
          && b.get('cofrePago', false) != true && getAfter(caminho('desafios_batalha', m().ref)).data.get('cofrePago', false) == true
          && m().valor == math.floor((b.cofre.get(b.desafianteId, 0) + b.cofre.get(b.desafiadoId, 0)) / 20.0);
      }
      allow read: if logado();
      allow create: if isAdmin() || (logado()
        && m().keys().hasOnly(['uid', 'nome', 'tipo', 'valor', 'data', 'ref', 'moeda'])
        && (m().get('moeda', 'ryos') == 'ryos' || m().tipo == 'aposta')
        && m().uid == request.auth.uid && m().valor is int && m().valor > 0 && m().data == request.time
        && bancoSobe()
        && ((m().tipo == 'doacao' && doacaoOk()) || (m().tipo == 'imposto_loja' && impostoOk())
            || (m().tipo == 'missao' && missaoOk()) || (m().tipo == 'arena' && arenaOk())
            || (m().tipo == 'aposta' && apostaOk())));
      allow update, delete: if isAdmin();
    }

    // ---------------- APOSTAS DA ARENA (pari-mutuel) ----------------
    // apostas_totais/{bid} = { ryos: {uidLutador: soma}, essencia_ninja: {...} } (somas das apostas LÍQUIDAS)
    // Só sobe junto com uma aposta nova deste jogador, no mesmo envio, pelo valor líquido dela.
    match /apostas_totais/{bid} {
      allow read: if logado();
      allow create, update: if isAdmin() || (logado() && somaDaAposta(bid));
      allow delete: if isAdmin();
      function somaDaAposta(bid) {
        let caminhoAposta = /databases/$(database)/documents/desafios_batalha/$(bid)/apostas/$(request.auth.uid);
        let ap = getAfter(caminhoAposta).data;
        let antes = resource == null ? {} : resource.data;
        let novo = request.resource.data;
        return !exists(caminhoAposta) && existsAfter(caminhoAposta)
          && novo.diff(antes).affectedKeys().hasOnly([ap.moeda])
          && novo[ap.moeda].diff(antes.get(ap.moeda, {})).affectedKeys().hasOnly([ap.lado])
          && novo[ap.moeda][ap.lado] == antes.get(ap.moeda, {}).get(ap.lado, 0) + ap.liquido;
      }
    }

    // ---------------- Catálogos: todos leem, só o Kage escreve ----------------
    match /jutsus/{id}      { allow read: if logado(); allow write: if isAdmin(); }
    match /ferramentas/{id} { allow read: if logado(); allow write: if isAdmin(); }
    match /itens/{id}       { allow read: if logado(); allow write: if isAdmin(); }
    match /missoes/{id}     { allow read: if logado(); allow write: if isAdmin(); }
    match /conquistas/{id}  { allow read: if logado(); allow write: if isAdmin(); }
    match /mentores/{id}    { allow read: if logado(); allow write: if isAdmin(); }
    match /game_config/{id} { allow read: if logado(); allow write: if isAdmin(); }

    // ---------------- Fichas dos ninjas ----------------
    match /users/{userId} {
      function antes()  { return resource.data; }
      function depois() { return request.resource.data; }
      function mudou()  { return depois().diff(antes()).affectedKeys(); }
      function dono()   { return logado() && request.auth.uid == userId; }
      function valor(m, k, padrao) { return numero(m.get(k, padrao)); }

      // Preço que o site mostra: em EN se o item tiver preco_en; senão Ryos (com promoção)
      function moedaDe(item) { return numero(item.get('preco_en', 0)) > 0 ? 'essencia_ninja' : 'ryos'; }
      function precoDe(item) {
        return moedaDe(item) == 'essencia_ninja'
          ? numero(item.preco_en)
          : ((item.get('preco_promocional', null) != null && numero(item.preco_promocional) > 0 && numero(item.preco_promocional) < numero(item.get('preco', 0)))
              ? numero(item.preco_promocional)
              : numero(item.get('preco', 0)));
      }
      function outraMoeda(m) { return m == 'ryos' ? 'essencia_ninja' : 'ryos'; }

      // XP necessário para subir do nível n (mesma regra do site)
      function xpNecessario(n) {
        let cfg = caminho('game_config', 'sistema_nivel');
        let tabela = exists(cfg) ? get(cfg).data.get('tabela_xp', []) : [];
        return (tabela.size() > 0 && n <= tabela.size()) ? numero(tabela[n - 1]) : 300;
      }

      // 1) Dados de perfil e preferências (não mexem em saldo)
      function perfil() {
        return mudou().hasOnly(['nome', 'apelido', 'historiaTexto', 'historiaImagem', 'personagem',
                                'avatar', 'isOnline', 'cenarioAtual', 'postsSalvos']);
      }

      // 2) Gastar vida/chakra/stamina em combate (só pode DIMINUIR)
      function naoAumentou(k) { return valor(depois(), k, 0) >= 0 && valor(depois(), k, 0) <= valor(antes(), k, 100); }
      function gastoEmCombate() {
        return mudou().hasOnly(['vida', 'chakra', 'stamina'])
          && naoAumentou('vida') && naoAumentou('chakra') && naoAumentou('stamina');
      }

      // 3) Subir de nível quando o XP alcança a meta
      function subirNivel() {
        return mudou().hasOnly(['nivel', 'xp']) && 'nivel' in mudou() && subirNivelValido(valor(antes(), 'nivel', 1));
      }
      function subirNivelValido(nivel) {
        return depois().nivel == nivel + 1
          && depois().xp == valor(antes(), 'xp', 0) - xpNecessario(nivel)
          && depois().xp >= 0;
      }

      // 4) Usar um item do inventário (quantidade -1)
      function consumirItem() {
        return depois().get('ultimoConsumo', null) != null && 'inventario' in mudou()
          && mudou().hasOnly(['inventario', 'stamina', 'ultimoConsumo']) && consumirItemValido();
      }
      function consumirItemValido() {
        let id = depois().ultimoConsumo;
        let invAntes = antes().get('inventario', {});
        let invDepois = depois().get('inventario', {});
        return mudou().hasOnly(['inventario', 'stamina', 'ultimoConsumo'])
          && invDepois.diff(invAntes).affectedKeys().hasOnly([id])
          && invDepois.get(id, 0) == invAntes.get(id, 0) - 1
          && invDepois.get(id, 0) >= 0
          && naoAumentou('stamina');
      }

      // 5) Comprar jutsu: paga exatamente o preço cadastrado e recebe o jutsu
      function comprarJutsu() {
        return depois().get('ultimaCompra', null) != null && depois().ultimaCompra.get('tipo', '') == 'jutsu'
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'meusJutsus', 'maestrias', 'ultimaCompra'])
          && 'meusJutsus' in mudou() && comprarJutsuValido();
      }
      function comprarJutsuValido() {
        let c = depois().ultimaCompra;
        let j = get(caminho('jutsus', c.id)).data;
        let moeda = moedaDe(j);
        let lista = antes().get('meusJutsus', []);
        return c.tipo == 'jutsu'
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'meusJutsus', 'maestrias', 'ultimaCompra'])
          && !(outraMoeda(moeda) in mudou())
          && !(c.id in lista)
          && depois().meusJutsus == lista.concat([c.id])
          && depois().get('maestrias', {}).diff(antes().get('maestrias', {})).affectedKeys().hasOnly([c.id])
          && valor(antes(), 'nivel', 1) >= numero(j.get('requisito', 0))
          && valor(depois(), moeda, 0) == valor(antes(), moeda, 0) - precoDe(j)
          && valor(depois(), moeda, 0) >= 0;
      }

      // 6) Comprar itens/ferramentas: paga preço × quantidade e recebe a quantidade
      function comprarItem() {
        return depois().get('ultimaCompra', null) != null && depois().ultimaCompra.get('tipo', '') in ['itens', 'ferramentas']
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'inventario', 'ultimaCompra'])
          && 'inventario' in mudou() && comprarItemValido();
      }
      function comprarItemValido() {
        let c = depois().ultimaCompra;
        let item = get(caminho(c.tipo, c.id)).data;
        let moeda = moedaDe(item);
        let invAntes = antes().get('inventario', {});
        let invDepois = depois().get('inventario', {});
        let qtd = invDepois.get(c.id, 0) - invAntes.get(c.id, 0);
        return c.tipo in ['itens', 'ferramentas']
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'inventario', 'ultimaCompra'])
          && !(outraMoeda(moeda) in mudou())
          && invDepois.diff(invAntes).affectedKeys().hasOnly([c.id])
          && qtd is int && qtd >= 1
          && valor(depois(), moeda, 0) == valor(antes(), moeda, 0) - precoDe(item) * qtd
          && valor(depois(), moeda, 0) >= 0;
      }

      // 7) Aceitar missão / pedir conquista (só muda o status para "pedido")
      function solicitar() {
        return depois().get('ultimaSolicitacao', null) != null
          && mudou().hasOnly(['statusMissoes', 'statusConquistas', 'ultimaSolicitacao'])
          && ('statusMissoes' in mudou() || 'statusConquistas' in mudou()) && solicitarValido();
      }
      function solicitarValido() {
        let id = depois().ultimaSolicitacao;
        let mAntes = antes().get('statusMissoes', {});
        let mDepois = depois().get('statusMissoes', {});
        let cAntes = antes().get('statusConquistas', {});
        let cDepois = depois().get('statusConquistas', {});
        return mudou().hasOnly(['statusMissoes', 'statusConquistas', 'ultimaSolicitacao'])
          && (
            (mDepois.diff(mAntes).affectedKeys().hasOnly([id]) && cDepois == cAntes
              && mAntes.get(id, null) == null && mDepois.get(id, '') == 'em_andamento'
              && exists(caminho('missoes', id)))
            ||
            (cDepois.diff(cAntes).affectedKeys().hasOnly([id]) && mDepois == mAntes
              && cAntes.get(id, null) == null && cDepois.get(id, '') == 'solicitado'
              && exists(caminho('conquistas', id)))
          );
      }

      // 8) Coletar recompensa APROVADA pelo Kage, no valor cadastrado
      function coletarMissao() {
        return depois().get('ultimaColeta', null) != null && depois().ultimaColeta.get('tipo', '') == 'missao'
          && 'statusMissoes' in mudou() && coletarMissaoValido();
      }
      function coletarMissaoValido() {
        let c = depois().ultimaColeta;
        let m = get(caminho('missoes', c.id)).data;
        let contador = 'missoes_concluidas_' + string(m.get('rank', 'D')).lower();
        let sAntes = antes().get('statusMissoes', {});
        let sDepois = depois().get('statusMissoes', {});
        return c.tipo == 'missao'
          && mudou().hasOnly(['ryos', 'xp', 'essencia_ninja', 'statusMissoes', 'ultimaColeta', contador])
          && sDepois.diff(sAntes).affectedKeys().hasOnly([c.id])
          && sAntes.get(c.id, '') == 'aprovado' && sDepois.get(c.id, '') == 'concluido'
          && valor(depois(), 'ryos', 0) == valor(antes(), 'ryos', 0) + valor(m, 'recompensa', 0)
          && valor(depois(), 'xp', 0) == valor(antes(), 'xp', 0) + valor(m, 'xp', 0)
          && valor(depois(), 'essencia_ninja', 0) == valor(antes(), 'essencia_ninja', 0) + valor(m, 'en', 0)
          && valor(depois(), contador, 0) == valor(antes(), contador, 0) + 1;
      }
      function coletarConquista() {
        return depois().get('ultimaColeta', null) != null && depois().ultimaColeta.get('tipo', '') == 'conquista'
          && 'statusConquistas' in mudou() && coletarConquistaValido();
      }
      function coletarConquistaValido() {
        let c = depois().ultimaColeta;
        let q = get(caminho('conquistas', c.id)).data;
        let sAntes = antes().get('statusConquistas', {});
        let sDepois = depois().get('statusConquistas', {});
        return c.tipo == 'conquista'
          && mudou().hasOnly(['ryos', 'xp', 'essencia_ninja', 'statusConquistas', 'ultimaColeta'])
          && sDepois.diff(sAntes).affectedKeys().hasOnly([c.id])
          && sAntes.get(c.id, '') == 'aprovado' && sDepois.get(c.id, '') == 'concluido'
          && valor(depois(), 'ryos', 0) == valor(antes(), 'ryos', 0) + valor(q, 'recompensa', 0)
          && valor(depois(), 'xp', 0) == valor(antes(), 'xp', 0) + valor(q, 'xp', 0)
          && valor(depois(), 'essencia_ninja', 0) == valor(antes(), 'essencia_ninja', 0) + valor(q, 'en', 0);
      }

      // 9) Trocar EN por Ryos na taxa oficial (1 EN = 10 Ryos, arredondando o custo para cima)
      function trocarEnPorRyos() {
        let ganho = valor(depois(), 'ryos', 0) - valor(antes(), 'ryos', 0);
        return mudou().hasOnly(['ryos', 'essencia_ninja'])
          && ganho > 0 && ganho == math.floor(ganho)
          && valor(depois(), 'essencia_ninja', 0) == valor(antes(), 'essencia_ninja', 0) - math.ceil(ganho / 10.0)
          && valor(depois(), 'essencia_ninja', 0) >= 0;
      }

      // 10) Roleta: registra o prêmio como PENDENTE (o Kage entrega pelo Painel)
      function novoPremioPendente() {
        let lista = antes().get('premios_pendentes', []);
        return depois().premios_pendentes.size() == lista.size() + 1
          && depois().premios_pendentes.hasAll(lista);
      }
      function roletaGratis() {
        let semana = 7 * 24 * 60 * 60 * 1000;
        return mudou().hasOnly(['ultimoGiroRoleta', 'premios_pendentes'])
          && request.time.toMillis() - valor(antes(), 'ultimoGiroRoleta', 0) >= semana
          && 'ultimoGiroRoleta' in mudou()
          && depois().ultimoGiroRoleta is number
          && depois().ultimoGiroRoleta <= request.time.toMillis() + 600000
          && depois().ultimoGiroRoleta >= request.time.toMillis() - 600000
          && novoPremioPendente();
      }
      function roletaPaga() {
        return mudou().hasOnly(['essencia_ninja', 'premios_pendentes'])
          && valor(depois(), 'essencia_ninja', 0) == valor(antes(), 'essencia_ninja', 0) - 15
          && valor(depois(), 'essencia_ninja', 0) >= 0
          && novoPremioPendente();
      }

      // 10b) Resgatar sozinho um prêmio da roleta (sem esperar o Kage):
      //   "Jutsu Rank B"          → um jutsu Rank B (que ele ainda não tem e pode usar)
      //   "Ferramenta Especial" / "Arma Ninja" → 1 unidade de um item marcado com premio_roleta
      //   "Modificador de Atributo" → +50 no atributo escolhido (ou no máximo de Vida/Chakra/Stamina)
      // O prêmio sai da lista (só aquele, pela posição) no MESMO envio.
      function tipoPremio(p) { return p.get('valor', p.get('item', '')); }
      function resgatarPremio() {
        return depois().get('ultimoResgate', null) != null && 'premios_pendentes' in mudou() && resgatarPremioValido(depois().ultimoResgate);
      }
      function resgatarPremioValido(r) {
        let lista = antes().get('premios_pendentes', []);
        return r.indice is int && r.indice >= 0 && r.indice < lista.size()
          && depois().premios_pendentes == semPosicao(lista, r.indice)
          && (resgateJutsu(r, tipoPremio(lista[r.indice])) || resgateItem(r, tipoPremio(lista[r.indice])) || resgateAtributo(r, tipoPremio(lista[r.indice])));
      }
      // A lista sem o item da posição i (cortes vazios dão erro nas regras, por isso os testes)
      function semPosicao(lista, i) {
        return (i == 0 ? [] : lista[0:i]).concat(i + 1 >= lista.size() ? [] : lista[i + 1:lista.size()]);
      }
      function resgateJutsu(r, tipo) {
        return r.tipo == 'jutsu' && tipo == 'Jutsu Rank B'
          && mudou().hasOnly(['meusJutsus', 'premios_pendentes', 'ultimoResgate']) && resgateJutsuValido(r);
      }
      function resgateJutsuValido(r) {
        let j = get(caminho('jutsus', r.id)).data;
        let lista = antes().get('meusJutsus', []);
        return string(j.get('rank', '')).upper() == 'B'
          && !(r.id in lista) && depois().meusJutsus == lista.concat([r.id])
          && (j.get('restrito_a', null) == null || j.restrito_a.size() == 0 || antes().get('nome', '') in j.restrito_a);
      }
      function resgateItem(r, tipo) {
        return r.tipo in ['ferramentas', 'itens'] && tipo in ['Ferramenta Especial', 'Arma Ninja']
          && mudou().hasOnly(['inventario', 'premios_pendentes', 'ultimoResgate']) && resgateItemValido(r, tipo);
      }
      function resgateItemValido(r, tipo) {
        let item = get(caminho(r.tipo, r.id)).data;
        let invA = antes().get('inventario', {});
        let invD = depois().get('inventario', {});
        return item.get('premio_roleta', '') == tipo
          && invD.diff(invA).affectedKeys().hasOnly([r.id])
          && invD.get(r.id, 0) == invA.get(r.id, 0) + 1;
      }
      function resgateAtributo(r, tipo) {
        return r.tipo == 'atributo' && tipo == 'Modificador de Atributo'
          && r.id in ['forca', 'defesa', 'constituicao', 'destreza', 'intelecto', 'agilidade', 'max_vida', 'max_chakra', 'max_stamina']
          && mudou().hasOnly([r.id, 'premios_pendentes', 'ultimoResgate'])
          && depois().get(r.id, 0) is number
          && depois().get(r.id, 0) == valor(antes(), r.id, 0) + 50;
      }

      // 10c) Doar Ryos para o Cofre da Vila (o comprovante em vila_movimentos confere o valor)
      function doarVila() {
        return depois().get('ultimaDoacao', null) != null && mudou().hasOnly(['ryos', 'ultimaDoacao', 'doado_vila'])
          && doarVilaValido(depois().ultimaDoacao);
      }
      function doarVilaValido(mid) {
        let v = valor(antes(), 'ryos', 0) - valor(depois(), 'ryos', 0);
        return v > 0 && valor(depois(), 'ryos', 0) >= 0
          && !exists(caminho('vila_movimentos', mid)) && existsAfter(caminho('vila_movimentos', mid))
          && getAfter(caminho('vila_movimentos', mid)).data.valor == v
          && valor(depois(), 'doado_vila', 0) == valor(antes(), 'doado_vila', 0) + v;
      }

      // 10d) Apostar numa luta (o dinheiro sai da ficha e a aposta entra na luta, no mesmo envio)
      function caminhoAposta(bid) { return /databases/$(database)/documents/desafios_batalha/$(bid)/apostas/$(userId); }
      function apostar() {
        return depois().get('ultimaAposta', null) != null && 'ultimaAposta' in mudou()
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'apostas_abertas', 'ultimaAposta']) && apostarValido(depois().ultimaAposta);
      }
      function apostarValido(bid) {
        let ap = getAfter(caminhoAposta(bid)).data;
        return !exists(caminhoAposta(bid)) && ap.uid == userId
          && !(outraMoeda(ap.moeda) in mudou())
          && valor(depois(), ap.moeda, 0) == valor(antes(), ap.moeda, 0) - ap.valor
          && valor(depois(), ap.moeda, 0) >= 0
          && depois().apostas_abertas == antes().get('apostas_abertas', []).concat([bid]);
      }
      // 10e) Receber a aposta depois da luta: vencedor divide o bolo (proporcional), empate/anulada devolve
      function receberAposta() {
        return depois().get('ultimaApostaPaga', null) != null && 'ultimaApostaPaga' in mudou()
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'apostas_abertas', 'ultimaApostaPaga']) && receberApostaValido(depois().ultimaApostaPaga);
      }
      function receberApostaValido(bid) {
        let ap = get(caminhoAposta(bid)).data;
        let b = get(batalha(bid)).data;
        return ap.uid == userId && ap.pago == false && getAfter(caminhoAposta(bid)).data.pago == true
          && b.get('estado', null) != null && b.estado.status == 'finalizada'
          && depois().apostas_abertas == antes().get('apostas_abertas', []).removeAll([bid])
          && !(outraMoeda(ap.moeda) in mudou())
          && valor(depois(), ap.moeda, 0) == valor(antes(), ap.moeda, 0) + premioDaAposta(ap, b, get(caminho('apostas_totais', bid)).data.get(ap.moeda, {}));
      }
      function premioDaAposta(ap, b, tot) {
        let venc = b.estado.resultado.get('vencedor', null);
        let bolo = tot.get(b.desafianteId, 0) + tot.get(b.desafiadoId, 0);
        return (venc == null || tot.get(venc, 0) == 0) ? ap.liquido
          : (venc == ap.lado ? math.floor(ap.liquido * bolo / tot.get(venc, 0)) : 0);
      }

      // 11) Presente/mentoria — lado de quem PAGA (a transferência é conferida em /transferencias)
      function pagarTransferencia() {
        return 'ultimaTransferencia' in mudou()
          && mudou().hasOnly(['ryos', 'essencia_ninja', 'ultimaTransferencia', 'aprendizados'])
          && pagarTransferenciaValido();
      }
      function pagarTransferenciaValido() {
        let tid = depois().ultimaTransferencia;
        let t = getAfter(caminho('transferencias', tid)).data;
        return mudou().hasOnly(['ryos', 'essencia_ninja', 'ultimaTransferencia', 'aprendizados'])
          && !exists(caminho('transferencias', tid))
          && t.de == userId
          && !(outraMoeda(t.tipo) in mudou())
          && valor(depois(), t.tipo, 0) == valor(antes(), t.tipo, 0) - t.qtd
          && valor(depois(), t.tipo, 0) >= 0
          && (!('aprendizados' in mudou()) || (t.motivo == 'mentoria'
                && depois().aprendizados.size() == antes().get('aprendizados', []).size() + 1
                && depois().aprendizados.hasAll(antes().get('aprendizados', []))));
      }
      // Presente/mentoria — lado de quem RECEBE (outro jogador escrevendo nesta ficha)
      function receberTransferencia() {
        return 'ultimaTransferenciaRecebida' in mudou() && mudou().size() == 2 && receberTransferenciaValido();
      }
      function receberTransferenciaValido() {
        let tid = depois().get('ultimaTransferenciaRecebida', '');
        let t = getAfter(caminho('transferencias', tid)).data;
        return tid != '' && !exists(caminho('transferencias', tid))
          && t.para == userId
          && mudou().hasOnly([t.tipo, 'ultimaTransferenciaRecebida'])
          && valor(depois(), t.tipo, 0) == valor(antes(), t.tipo, 0) + t.qtd;
      }

      // 12) ARENA — cofre do modo Competitivo e resultado das lutas
      function batalha(id) { return caminho('desafios_batalha', id); }
      function participaDe(b) { return b.desafianteId == userId || b.desafiadoId == userId; }
      function minimoDaMoeda(m) { return m == 'xp' ? 10 : 0; }   // XP: precisa sobrar 10 na barra do nível
      function moedaDoCofre() { return mudou().hasOnly(['ryos', 'essencia_ninja', 'xp', 'ultimoCofre']) && mudou().size() <= 2; }

      // Paga a própria aposta para o cofre (ao desafiar ou ao aceitar)
      function pagarCofre() {
        return depois().get('ultimoCofre', null) != null && moedaDoCofre() && pagarCofreValido(depois().ultimoCofre);
      }
      function pagarCofreValido(bid) {
        let b = getAfter(batalha(bid)).data;
        let m = b.aposta.moeda;
        return participaDe(b)
          && (!exists(batalha(bid)) || get(batalha(bid)).data.get('cofre', {}).get(userId, null) == null)
          && b.cofre[userId] == b.aposta.valor
          && valor(depois(), m, 0) == valor(antes(), m, 0) - b.aposta.valor
          && valor(depois(), m, 0) >= minimoDaMoeda(m);
      }
      // Vencedor recebe o cofre inteiro (uma única vez)
      function receberCofre() {
        return depois().get('ultimoCofre', null) != null && moedaDoCofre() && receberCofreValido(depois().ultimoCofre);
      }
      function receberCofreValido(bid) {
        let b = get(batalha(bid)).data;
        let m = b.aposta.moeda;
        return b.estado.status == 'finalizada' && b.estado.resultado.vencedor == userId
          && b.get('cofrePago', false) != true && getAfter(batalha(bid)).data.get('cofrePago', false) == true
          && valor(depois(), m, 0) == valor(antes(), m, 0) + premioDoCofre(m, b.cofre.get(b.desafianteId, 0) + b.cofre.get(b.desafiadoId, 0));
      }
      // Em Ryos, 5% do cofre vai para o Cofre da Vila (se ele existir)
      function premioDoCofre(m, total) {
        return (m == 'ryos' && exists(caminho('vila', 'banco'))) ? total - math.floor(total / 20.0) : total;
      }
      // Devolve a própria aposta (convite recusado/cancelado, luta anulada ou empate)
      function devolverCofre() {
        return depois().get('ultimoCofre', null) != null && moedaDoCofre() && devolverCofreValido(depois().ultimoCofre);
      }
      function devolverCofreValido(bid) {
        let b = get(batalha(bid)).data;
        let m = b.aposta.moeda;
        return participaDe(b)
          && (b.status in ['recusado', 'cancelado', 'anulada'] || (b.get('estado', null) != null && b.estado.status == 'finalizada' && b.estado.resultado.empate == true))
          && b.get('cofrePago', false) != true
          && b.get('cofreDevolvido', {}).get(userId, false) != true
          && getAfter(batalha(bid)).data.get('cofreDevolvido', {}).get(userId, false) == true
          && valor(depois(), m, 0) == valor(antes(), m, 0) + b.cofre.get(userId, 0);
      }
      // Vitórias, derrotas, empates e pontos (uma única vez por luta)
      function contabilizarBatalha() {
        return depois().get('ultimaBatalhaContabilizada', null) != null
          && mudou().hasOnly(['vitorias', 'derrotas', 'empates', 'pontos_rankeada', 'pontos_amistoso', 'ultimaBatalhaContabilizada'])
          && contabilizarValido(depois().ultimaBatalhaContabilizada);
      }
      function mais1(k, condicao) { return valor(depois(), k, 0) == valor(antes(), k, 0) + (condicao ? 1 : 0); }
      function contabilizarValido(bid) {
        let b = get(batalha(bid)).data;
        let r = b.estado.resultado;
        let modo = b.get('modo', 'amistoso');
        let venci = r.vencedor == userId;
        let perdi = r.get('perdedor', null) == userId;
        let pontos = valor(antes(), 'pontos_rankeada', 0);
        let pontosEsperados = (modo == 'rankeada' && venci) ? pontos + 25 : ((modo == 'rankeada' && perdi) ? (pontos > 15 ? pontos - 15 : 0) : pontos);
        return participaDe(b) && b.estado.status == 'finalizada'
          && b.get('contabilizado', {}).get(userId, false) != true
          && getAfter(batalha(bid)).data.get('contabilizado', {}).get(userId, false) == true
          && mais1('vitorias', venci) && mais1('derrotas', perdi) && mais1('empates', r.empate == true)
          && mais1('pontos_amistoso', modo == 'amistoso' && venci)
          && valor(depois(), 'pontos_rankeada', 0) == pontosEsperados;
      }

      allow read: if logado();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (dono() && (perfil() || gastoEmCombate() || subirNivel() || consumirItem()
                       || comprarJutsu() || comprarItem() || solicitar()
                       || coletarMissao() || coletarConquista() || trocarEnPorRyos()
                       || roletaGratis() || roletaPaga() || resgatarPremio() || doarVila() || apostar() || receberAposta() || pagarTransferencia()
                       || pagarCofre() || receberCofre() || devolverCofre() || contabilizarBatalha()))
        || (logado() && !dono() && receberTransferencia());
    }

    // ---------------- Comprovantes de presentes e mentorias ----------------
    // Cada presente/mentoria cria um comprovante. Ele só é aceito se, no MESMO envio,
    // o saldo de quem paga diminuir e o de quem recebe aumentar exatamente o valor.
    match /transferencias/{tid} {
      function t() { return request.resource.data; }
      function quemPaga() { return caminho('users', t().de); }
      function mentoriaValida() {
        let m = get(caminho('mentores', t().mentorId)).data;
        let ensino = m.ensinos[t().ensinoIdx];
        let alvo = m.get('uid_player', '');
        return t().qtd == numero(ensino.preco)
          && t().tipo == (ensino.get('moeda', 'ryos') == 'essencia_ninja' ? 'essencia_ninja' : 'ryos')
          && t().para == (alvo == '' ? null : alvo);
      }
      allow read: if logado() && (isAdmin() || resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow create: if logado()
        && t().keys().hasOnly(['de', 'para', 'tipo', 'qtd', 'motivo', 'data', 'mentorId', 'ensinoIdx'])
        && t().de == request.auth.uid
        && t().tipo in ['ryos', 'essencia_ninja']
        && t().qtd is number && t().qtd > 0
        && getAfter(quemPaga()).data.get('ultimaTransferencia', '') == tid
        && numero(getAfter(quemPaga()).data.get(t().tipo, 0)) == numero(get(quemPaga()).data.get(t().tipo, 0)) - t().qtd
        && (t().para == null || (
              t().para != t().de
              && getAfter(caminho('users', t().para)).data.get('ultimaTransferenciaRecebida', '') == tid
              && numero(getAfter(caminho('users', t().para)).data.get(t().tipo, 0)) == numero(get(caminho('users', t().para)).data.get(t().tipo, 0)) + t().qtd))
        && ((t().motivo == 'presente' && t().para != null) || (t().motivo == 'mentoria' && mentoriaValida()));
      allow update, delete: if isAdmin();
    }

    // ---------------- Feed ----------------
    match /posts/{postId} {
      function curtida() {
        let a = resource.data.get('likes', []).toSet();
        let d = request.resource.data.get('likes', []).toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && d.difference(a).union(a.difference(d)) == [request.auth.uid].toSet();
      }
      function comentario() {
        let velhos = resource.data.get('comentarios', []);
        let novos = request.resource.data.get('comentarios', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comentarios'])
          && novos.size() == velhos.size() + 1
          && novos.hasAll(velhos)
          && novos[novos.size() - 1].uid == request.auth.uid;
      }
      allow read: if logado();
      allow create: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('likes', []).size() == 0
        && request.resource.data.get('comentarios', []).size() == 0;
      allow update: if isAdmin() || (logado() && (curtida() || comentario()));
      allow delete: if isAdmin() || (logado() && resource.data.uid == request.auth.uid);
    }

    // ---------------- Frases ----------------
    match /frases/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (logado() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto']));
      allow delete: if isAdmin() || (logado() && resource.data.uid == request.auth.uid);
    }

    // ---------------- Chats ----------------
    // Salas: "uidA_uidB" (privado), "diario_uid" (diário com o Mestre), "cenario_x" (grupo)
    match /chats/{salaId} {
      function participaDaSala() {
        return logado() && (isAdmin() || salaId.matches('cenario_.*') || request.auth.uid in salaId.split('_'));
      }
      allow get, create, update: if participaDaSala();
      allow list: if logado() && (isAdmin() || request.auth.uid in resource.data.participantes);
      allow delete: if isAdmin();

      match /mensagens/{msgId} {
        allow read: if participaDaSala();
        allow create: if participaDaSala()
          && request.resource.data.remetenteId == request.auth.uid
          && (request.resource.data.tipo in ['rp', 'ooc', 'dice'] || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // ---------------- Desafios / Arena ----------------
    match /desafios_batalha/{id} {
      function participa() {
        return logado() && (request.auth.uid == resource.data.desafianteId || request.auth.uid == resource.data.desafiadoId);
      }
      allow read: if logado();   // lutas são públicas: espectadores podem assistir
      allow create: if logado() && request.resource.data.desafianteId == request.auth.uid
        && request.resource.data.desafiadoId != request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.get('modo', 'amistoso') in ['amistoso', 'rankeada', 'competitivo']
        && (request.resource.data.get('modo', 'amistoso') != 'competitivo' || (
              request.resource.data.aposta.moeda in ['ryos', 'essencia_ninja', 'xp']
              && request.resource.data.aposta.valor is int && request.resource.data.aposta.valor > 0));
      allow update, delete: if isAdmin() || participa();

      // Apostas dos espectadores (o id do documento é o uid de quem aposta: uma aposta por luta)
      match /apostas/{uid} {
        function a() { return request.resource.data; }
        function luta() { return get(/databases/$(database)/documents/desafios_batalha/$(id)).data; }
        function lutaAberta(b) {
          return b.status == 'aceito' && b.get('estado', null) != null && b.estado.status == 'em_andamento' && b.estado.turno < 2
            && !(uid in [b.desafianteId, b.desafiadoId]) && a().lado in [b.desafianteId, b.desafiadoId];
        }
        allow read: if logado();
        allow create: if logado() && uid == request.auth.uid
          && a().keys().hasOnly(['uid', 'nome', 'lado', 'moeda', 'valor', 'liquido', 'pago', 'em'])
          && a().uid == uid && a().moeda in ['ryos', 'essencia_ninja']
          && a().valor is int && a().valor >= 20
          && a().liquido == a().valor - math.floor(a().valor / 20.0) && a().pago == false
          && lutaAberta(luta())
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('ultimaAposta', '') == id
          && existsAfter(/databases/$(database)/documents/vila_movimentos/$('aposta_' + id + '_' + uid));
        // Só marca como paga (o valor recebido é conferido na ficha)
        allow update: if isAdmin() || (logado() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pago'])
          && resource.data.pago == false && request.resource.data.pago == true);
        allow delete: if isAdmin();
      }

      // Torcida: cada espectador tem 1 documento (presença + último emoji)
      match /torcida/{uid} {
        allow read: if logado();
        allow create, update: if logado() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['nome', 'lado', 'emoji', 'em', 'visto'])
          && request.resource.data.get('emoji', '') in ['', '🔥', '👏', '😱', '💪', '😂', '❤️', '⚡', '🍥']
          && (request.resource.data.get('nome', '') is string) && request.resource.data.get('nome', '').size() <= 60;
        allow delete: if isAdmin() || (logado() && uid == request.auth.uid);
      }
    }

    // Qualquer outra coleção: só o Kage
    match /{documento=**} {
      allow read, write: if isAdmin();
    }
  }
}
